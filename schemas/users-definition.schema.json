{
  "$id": "https://raw.githubusercontent.com/Syntax-Syllogism/warden-core/release/schemas/users-definition.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": {},
  "description": "A Warden JSON users definition file.",
  "properties": {
    "schemaVersion": {
      "const": 1,
      "description": "Supported file schema version. Omit it for version 1.",
      "type": "number"
    },
    "users": {
      "description": "User definitions.",
      "items": {
        "additionalProperties": {},
        "description": "A User field record with optional Warden metadata.",
        "properties": {
          "personas": {
            "description": "Persona names to merge for this user.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "related": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "relatedContext": {
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "number"
                },
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                },
                {
                  "additionalProperties": false,
                  "properties": {
                    "lookup": {
                      "additionalProperties": false,
                      "properties": {
                        "field": {
                          "minLength": 1,
                          "type": "string"
                        },
                        "sobject": {
                          "minLength": 1,
                          "type": "string"
                        },
                        "value": {
                          "anyOf": [
                            {
                              "additionalProperties": false,
                              "properties": {
                                "from": {
                                  "description": "A source such as user.Department, user.Id, or context.account.",
                                  "type": "string"
                                }
                              },
                              "required": [
                                "from"
                              ],
                              "type": "object"
                            },
                            {
                              "additionalProperties": false,
                              "properties": {
                                "value": {
                                  "description": "A literal value."
                                }
                              },
                              "required": [
                                "value"
                              ],
                              "type": "object"
                            }
                          ]
                        }
                      },
                      "required": [
                        "sobject",
                        "field",
                        "value"
                      ],
                      "type": "object"
                    }
                  },
                  "required": [
                    "lookup"
                  ],
                  "type": "object"
                }
              ]
            },
            "propertyNames": {
              "type": "string"
            },
            "type": "object"
          }
        },
        "type": "object"
      },
      "type": "array"
    }
  },
  "required": [
    "users"
  ],
  "title": "Warden users definition schema",
  "type": "object"
}
