{
  "$id": "https://raw.githubusercontent.com/Syntax-Syllogism/warden-core/release/schemas/conformance-fixture.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A Warden v1 conformance fixture: definitions plus simulated org state and expected plan.",
  "properties": {
    "definitions": {
      "additionalProperties": false,
      "description": "Persona and user definition documents used as conformance input.",
      "properties": {
        "personas": {
          "additionalProperties": {},
          "description": "Persona definitions used by the fixture.",
          "properties": {
            "personas": {
              "additionalProperties": {
                "additionalProperties": {},
                "description": "A reusable set of User fields and assignments. Unknown metadata keys are preserved.",
                "properties": {
                  "permissionSetGroupMode": {
                    "description": "Permission Set Group assignment mode.",
                    "enum": [
                      "additive",
                      "sync"
                    ],
                    "type": "string"
                  },
                  "permissionSetGroups": {
                    "description": "Permission Set Group names or Salesforce Ids.",
                    "items": {
                      "type": "string"
                    },
                    "type": "array"
                  },
                  "permissionSetMode": {
                    "description": "Permission Set assignment mode.",
                    "enum": [
                      "additive",
                      "sync"
                    ],
                    "type": "string"
                  },
                  "permissionSets": {
                    "description": "Permission Set names or Salesforce Ids.",
                    "items": {
                      "type": "string"
                    },
                    "type": "array"
                  },
                  "profile": {
                    "description": "Profile name or Salesforce Id.",
                    "type": "string"
                  },
                  "publicGroupMode": {
                    "description": "Public Group assignment mode.",
                    "enum": [
                      "additive",
                      "sync"
                    ],
                    "type": "string"
                  },
                  "publicGroups": {
                    "description": "Public Group names or Salesforce Ids.",
                    "items": {
                      "type": "string"
                    },
                    "type": "array"
                  },
                  "queueMode": {
                    "description": "Queue assignment mode.",
                    "enum": [
                      "additive",
                      "sync"
                    ],
                    "type": "string"
                  },
                  "queues": {
                    "description": "Queue names or Salesforce Ids.",
                    "items": {
                      "type": "string"
                    },
                    "type": "array"
                  },
                  "role": {
                    "description": "Role name or Salesforce Id.",
                    "type": "string"
                  },
                  "userAttributes": {
                    "additionalProperties": {},
                    "description": "User fields applied by this persona.",
                    "propertyNames": {
                      "type": "string"
                    },
                    "type": "object"
                  }
                },
                "type": "object"
              },
              "description": "Persona definitions keyed by persona name.",
              "propertyNames": {
                "type": "string"
              },
              "type": "object"
            },
            "schemaVersion": {
              "const": 1,
              "description": "Supported file schema version. Omit it for version 1.",
              "type": "number"
            }
          },
          "required": [
            "personas"
          ],
          "type": "object"
        },
        "users": {
          "additionalProperties": {},
          "description": "The users definition embedded in a conformance fixture.",
          "properties": {
            "schemaVersion": {
              "const": 1,
              "description": "Supported file schema version. Omit it for version 1.",
              "type": "number"
            },
            "users": {
              "description": "Fixture users.",
              "items": {
                "additionalProperties": {},
                "description": "A user definition with the identity fields required by conformance planning.",
                "properties": {
                  "personas": {
                    "description": "Persona names to merge for this user.",
                    "items": {
                      "type": "string"
                    },
                    "type": "array"
                  },
                  "related": {
                    "items": {
                      "type": "string"
                    },
                    "type": "array"
                  },
                  "relatedContext": {
                    "additionalProperties": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "number"
                        },
                        {
                          "type": "boolean"
                        },
                        {
                          "type": "null"
                        },
                        {
                          "additionalProperties": false,
                          "properties": {
                            "lookup": {
                              "additionalProperties": false,
                              "properties": {
                                "field": {
                                  "minLength": 1,
                                  "type": "string"
                                },
                                "sobject": {
                                  "minLength": 1,
                                  "type": "string"
                                },
                                "value": {
                                  "anyOf": [
                                    {
                                      "additionalProperties": false,
                                      "properties": {
                                        "from": {
                                          "description": "A source such as user.Department, user.Id, or context.account.",
                                          "type": "string"
                                        }
                                      },
                                      "required": [
                                        "from"
                                      ],
                                      "type": "object"
                                    },
                                    {
                                      "additionalProperties": false,
                                      "properties": {
                                        "value": {
                                          "description": "A literal value."
                                        }
                                      },
                                      "required": [
                                        "value"
                                      ],
                                      "type": "object"
                                    }
                                  ]
                                }
                              },
                              "required": [
                                "sobject",
                                "field",
                                "value"
                              ],
                              "type": "object"
                            }
                          },
                          "required": [
                            "lookup"
                          ],
                          "type": "object"
                        }
                      ]
                    },
                    "propertyNames": {
                      "type": "string"
                    },
                    "type": "object"
                  },
                  "userId": {
                    "description": "Simulated Salesforce User Id.",
                    "minLength": 1,
                    "type": "string"
                  },
                  "userKey": {
                    "description": "Stable engine-neutral user key.",
                    "minLength": 1,
                    "type": "string"
                  }
                },
                "required": [
                  "userKey",
                  "userId"
                ],
                "type": "object"
              },
              "type": "array"
            }
          },
          "required": [
            "users"
          ],
          "type": "object"
        }
      },
      "required": [
        "personas",
        "users"
      ],
      "type": "object"
    },
    "expectedPlan": {
      "description": "Expected deterministic reconciliation plan rows.",
      "items": {
        "additionalProperties": false,
        "description": "One deterministic reconciliation plan row.",
        "properties": {
          "action": {
            "enum": [
              "wouldAssign",
              "unresolved"
            ],
            "type": "string"
          },
          "category": {
            "enum": [
              "PermissionSet",
              "PermissionSetGroup",
              "PublicGroup",
              "Queue"
            ],
            "type": "string"
          },
          "detail": {
            "type": "string"
          },
          "error": {
            "type": "string"
          },
          "status": {
            "enum": [
              "planned",
              "unmanaged"
            ],
            "type": "string"
          },
          "userId": {
            "minLength": 1,
            "type": "string"
          },
          "userKey": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "userKey",
          "userId",
          "category",
          "action",
          "status",
          "detail",
          "error"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "orgState": {
      "additionalProperties": {},
      "description": "A simulated current-org setup-object and assignment snapshot.",
      "properties": {
        "groupMembers": {
          "description": "Existing GroupMember rows.",
          "items": {
            "additionalProperties": {},
            "description": "A simulated GroupMember row.",
            "properties": {
              "groupId": {
                "description": "Group Id.",
                "minLength": 1,
                "type": "string"
              },
              "id": {
                "description": "Simulated GroupMember Id.",
                "minLength": 1,
                "type": "string"
              },
              "userId": {
                "description": "Member User Id.",
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "id",
              "userId",
              "groupId"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "groups": {
          "description": "Public Groups and Queues available for reference resolution.",
          "items": {
            "additionalProperties": {},
            "description": "A simulated Public Group or Queue.",
            "properties": {
              "developerName": {
                "description": "DeveloperName used for a setup reference.",
                "minLength": 1,
                "type": "string"
              },
              "id": {
                "description": "Simulated Salesforce Id.",
                "minLength": 1,
                "type": "string"
              },
              "label": {
                "description": "Human-readable target label.",
                "minLength": 1,
                "type": "string"
              },
              "name": {
                "description": "Permission Set name or group name.",
                "minLength": 1,
                "type": "string"
              },
              "type": {
                "description": "Salesforce Group type.",
                "enum": [
                  "Regular",
                  "Queue"
                ],
                "type": "string"
              }
            },
            "required": [
              "id",
              "type"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "permissionSetAssignments": {
          "description": "Existing PermissionSetAssignment rows.",
          "items": {
            "additionalProperties": {},
            "description": "A simulated PermissionSetAssignment row.",
            "properties": {
              "id": {
                "description": "Simulated PermissionSetAssignment Id.",
                "minLength": 1,
                "type": "string"
              },
              "permissionSetGroupId": {
                "anyOf": [
                  {
                    "minLength": 1,
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "permissionSetId": {
                "anyOf": [
                  {
                    "minLength": 1,
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "userId": {
                "description": "Assigned User Id.",
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "id",
              "userId"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "permissionSetGroups": {
          "description": "Permission Set Groups available for reference resolution.",
          "items": {
            "additionalProperties": {},
            "description": "A simulated setup-object reference.",
            "properties": {
              "developerName": {
                "description": "DeveloperName used for a setup reference.",
                "minLength": 1,
                "type": "string"
              },
              "id": {
                "description": "Simulated Salesforce Id.",
                "minLength": 1,
                "type": "string"
              },
              "label": {
                "description": "Human-readable target label.",
                "minLength": 1,
                "type": "string"
              },
              "name": {
                "description": "Permission Set name or group name.",
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "id"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "permissionSets": {
          "description": "Permission Sets available for reference resolution.",
          "items": {
            "additionalProperties": {},
            "description": "A simulated setup-object reference.",
            "properties": {
              "developerName": {
                "description": "DeveloperName used for a setup reference.",
                "minLength": 1,
                "type": "string"
              },
              "id": {
                "description": "Simulated Salesforce Id.",
                "minLength": 1,
                "type": "string"
              },
              "label": {
                "description": "Human-readable target label.",
                "minLength": 1,
                "type": "string"
              },
              "name": {
                "description": "Permission Set name or group name.",
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "id"
            ],
            "type": "object"
          },
          "type": "array"
        }
      },
      "required": [
        "permissionSets",
        "permissionSetGroups",
        "groups",
        "permissionSetAssignments",
        "groupMembers"
      ],
      "type": "object"
    },
    "schemaVersion": {
      "const": 1,
      "description": "Conformance fixture format version.",
      "type": "number"
    }
  },
  "required": [
    "schemaVersion",
    "definitions",
    "orgState",
    "expectedPlan"
  ],
  "title": "Warden conformance fixture schema",
  "type": "object"
}
